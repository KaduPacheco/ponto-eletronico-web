# Public frontend variables used by the landing page and authenticated CRM.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_SUPABASE_ANON_KEY

# Required server-side intake endpoint exposed by Supabase Edge Functions.
VITE_LEAD_INTAKE_URL=https://YOUR-PROJECT.supabase.co/functions/v1/lead-intake
VITE_ANALYTICS_INTAKE_URL=https://YOUR-PROJECT.supabase.co/functions/v1/analytics-intake

# Server-side only automation settings. Never prefix these with VITE_.
# PUBLIC_SITE_ORIGIN=
# N8N_LEAD_AUTOMATION_URL=
# N8N_LEAD_AUTOMATION_SECRET=
# INTAKE_RATE_LIMIT_PEPPER=
# LEAD_OUTBOX_WORKER_TOKEN=
# LEAD_OUTBOX_BATCH_SIZE=10
# LEAD_OUTBOX_MAX_ATTEMPTS=8
# LEAD_OUTBOX_DELIVERY_TIMEOUT_MS=5000
